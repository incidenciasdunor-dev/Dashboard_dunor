rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Reglas para la colección 'users':
    // - Permitir 'get' individual para que la pantalla de login/registro verifique si un correo está dado de alta o registrado.
    // - Permitir 'create' y 'update' para que usuarios nuevos puedan completar su registro y generar contraseña.
    // - Exigir autenticación para listar todos los usuarios (list) o eliminar cuentas (delete).
    match /users/{userId} {
      allow get: if true;
      allow create, update: if true;
      allow list, delete: if isAuthenticated();
    }

    // Todas las demás colecciones requieren autenticación para leer o escribir.
    match /incidents/{incidentId} {
      allow read, write: if isAuthenticated();
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    match /permisos/{permisoId} {
      allow read, write: if isAuthenticated();
    }

    match /mail/{mailId} {
      allow read, write: if isAuthenticated();
    }

    match /logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /referrals/{referralId} {
      allow read, write: if isAuthenticated();
    }

    match /expedientes/{expedienteId} {
      allow read, write: if isAuthenticated();
    }

    // Regla global de protección para cualquier otra colección o subcolección
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}



