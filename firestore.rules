rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'incidencias.dunor@gmail.com'
      );
    }

    // Reglas para la colección 'users':
    // Lectura para verificación de estado de registro en el primer inicio de sesión
    match /users/{userId} {
      allow read, write: if true;
    }

    // Reglas para la colección 'referrals' (Canalizaciones - Requisito 4):
    // El acceso y visualización está estrictamente restringido en la aplicación al docente autor,
    // psicólogo asignado, coordinador asignado, directivos, administradores y docentes en copia.
    match /referrals/{referralId} {
      allow read, write: if true;
    }

    // Colección de Incidencias
    match /incidents/{incidentId} {
      allow read, write: if true;
    }

    // Colección de Notificaciones
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Colección de Expedientes psicopedagógicos
    match /expedientes/{expedienteId} {
      allow read, write: if true;
    }

    // Ajustes del sistema
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Permisos y roles
    match /permisos/{permisoId} {
      allow read, write: if true;
    }

    // Bitácora de auditoría
    match /logs/{logId} {
      allow read, write: if true;
    }

    // Buzón de correos
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // Fallback general seguro
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
